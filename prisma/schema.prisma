// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Roles de usuario
// ADMIN = Puede crear, modificar y eliminar recursos y usuarios
// GUEST = Solo puede ver recursos
//
// Multitenancy: un User con ownerId = NULL es la raíz de un tenant.
// Los demás usuarios cuelgan de esa raíz (ownerId apunta a ella).
// El tenant efectivo de cualquier usuario es COALESCE(ownerId, id).
model User {
    id        String   @id @default(cuid())
    email     String   @unique
    password  String // Hashed password
    name      String
    role      String   @default("GUEST") // ADMIN, GUEST
    ownerId   String? // null => este user ES la raíz de un tenant
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    owner    User?  @relation("TenantMiembros", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    miembros User[] @relation("TenantMiembros")

    proyectos Proyecto[] @relation("TenantProyectos")

    @@index([email])
    @@index([role])
    @@index([ownerId])
}

// Estado operativo del proyecto
// NOT_STARTED = No comenzó
// IN_PROGRESS = Comenzó
// FINISHED = Finalizó
// Moneda del proyecto
// UYU = Pesos Uruguayos
// USD = Dólares Americanos
model Proyecto {
    id                  String   @id @default(cuid())
    ownerId             String
    identificador       String
    identifier_num      Int
    nombre              String
    montoTotal          Float
    comisionPct         Float
    estado              String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, FINISHED
    moneda              String   @default("USD") // UYU, USD
    project_approved_at DateTime
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    owner         User          @relation("TenantProyectos", fields: [ownerId], references: [id], onDelete: Restrict)
    facturaciones Facturacion[]

    @@unique([ownerId, identificador])
    @@unique([ownerId, identifier_num])
    @@unique([id, ownerId]) // destino del FK compuesto de Facturacion
    @@index([ownerId])
    @@index([ownerId, moneda])
    @@index([identificador])
    @@index([identifier_num])
    @@index([estado])
    @@index([moneda])
    @@index([project_approved_at])
}

// Estado de la facturación
// EMITIDA = Factura emitida, pendiente de cobro
// COBRADA = Factura cobrada
model Facturacion {
    id               String    @id @default(cuid())
    ownerId          String // Desnormalizado del Proyecto padre (ver FK compuesto abajo)
    proyectoId       String
    descripcion      String // APROBACION, ENTREGA_PARCIAL, ENTREGA_TOTAL
    porcentaje       Float // Porcentaje del monto total del proyecto
    monto            Float // Calculado: proyecto.montoTotal * porcentaje / 100
    fechaFacturacion DateTime
    estado           String    @default("EMITIDA") // EMITIDA, COBRADA
    fechaCobro       DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    // FK compuesto: garantiza que Facturacion.ownerId SIEMPRE coincide con el
    // ownerId de su Proyecto (estado inconsistente irrepresentable en la base).
    proyecto Proyecto @relation(fields: [proyectoId, ownerId], references: [id, ownerId], onDelete: Cascade)

    @@index([ownerId])
    @@index([ownerId, estado])
    @@index([proyectoId])
    @@index([estado])
    @@index([fechaCobro])
}
